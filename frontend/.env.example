# Where `npm run dev` proxies /api requests (the .NET API).
VITE_API_PROXY_TARGET=http://localhost:5080
# Absolute API URL baked in at BUILD time (cloud builds, e.g. https://api-iplstore-prod.azurecontainerapps.io/api/v1).
# Leave unset locally: the app then calls the relative /api/v1.
# VITE_API_BASE_URL=
